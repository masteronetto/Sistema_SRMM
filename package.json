{
  "name": "sistema-srmm",
  "version": "0.1.0",
  "private": true,
  "description": "API base SRMM para gestion de usuarios",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:start": "bash scripts/start-db.sh",
    "db:stop": "docker-compose down",
    "db:logs": "docker-compose logs -f postgres",
    "db:connect": "docker-compose exec postgres psql -U postgres -d srmm_db",
    "db:status": "docker-compose ps"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pngjs": "^7.0.0",
    "pg": "^8.12.0",
    "socket.io": "^4.8.3",
    "jsonwebtoken": "^9.0.0",
    "bcryptjs": "^2.4.3",
    "nodemailer": "^6.9.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
